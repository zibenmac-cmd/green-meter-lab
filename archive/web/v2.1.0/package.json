{
  "name": "green-meter-lab-web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.cloudflare.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.cloudflare.config.ts",
    "preview": "wrangler dev --config wrangler.jsonc --ip 127.0.0.1",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "test": "node --test tests/web-v2/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "@cloudflare/workers-types": "4.20260515.1",
    "wrangler": "4.92.0"
  },
  "packageManager": "pnpm@11.25.0"
}
